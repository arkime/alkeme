              "TLP": "green",
              "adversary": "Adversary Profile: Salt Typhoon Alignment The architectural gap identified by mudoSO mirrors the act",
              "attack_ids": [],
              "author": {
                "avatar_url": "https://otx.alienvault.com/assets/images/default-avatar.png",
